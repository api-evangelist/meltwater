          "id": "1c2e6283-2ffb-4454-acb3-25e0ff8d81b0",
          "name": "Chat responses endpoint",
          "request": {
            "name": "Chat responses endpoint",
            "description": {
              "content": "Processes chat responses requests with multiple input messages and returns responses in streaming or non-streaming mode.\nIf Thread-ID header is provided, uses the existing thread; otherwise creates a new thread with all messages and passes only the last user message to Mira.\nThe thread ID is returned in the Thread-ID response header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "mira",
                "responses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "company_id",
                  "value": "<string>",
                  "description": "The ID of the company to access. If not provided, your default company will be used."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional thread ID. If provided, uses the existing thread; otherwise creates a new thread",
                "key": "Thread-ID",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Optional project ID for enhanced context",
                "key": "Project-ID",
                "value": "<string>"
              },
              {
