{
  "opencollection": "1.0.0",
  "info": {
    "name": "Meltwater Account Management Listening Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Listening Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search for Meltwater earned data using a saved search and optional filters.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meltwater.com/v3/search/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Search ID"
              },
              {
                "name": "company_id",
                "value": "",
                "type": "query",
                "description": "Set the company to search by"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search for Meltwater earned data using a saved search and optional filters."
        }
      ]
    }
  ],
  "bundled": true
}